{"conflicts_with": null, "content": {"text": "Jolene: Glimpsing that calms me. Taking beach walks relaxes me."}, "creation_event": "v3-ingest-3.3-V3-FULL-2026-09-08-locomo-conv-48/session_25-649b3f5d330fc108a6d95d5c", "creation_timestamp": "2026-09-08T13:15:11.227262+00:00", "equivalent_to": null, "lifecycle_state": "CREATED", "memory_id": "649b3f5d330fc108a6d95d5c", "memory_type": "foundation", "parent_ids": [], "source": {"reference_id": "649b3f5d330fc108a6d95d5c", "source_type": "phase2_umr"}, "superseded_by": null}
