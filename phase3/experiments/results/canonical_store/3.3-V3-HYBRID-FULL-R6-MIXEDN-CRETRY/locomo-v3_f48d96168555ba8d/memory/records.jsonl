{"conflicts_with": null, "content": {"text": "Joanna: Cool, Nate! So we both have similar interests. What type of movies do you like best?"}, "creation_event": "v3-ingest-3.3-V3-HYBRID-FULL-R6-MIXEDN-CRETRY-locomo-conv-42/session_1-f764740859c49456e39e445c", "creation_timestamp": "2026-09-15T14:20:52.304017+00:00", "equivalent_to": null, "lifecycle_state": "CREATED", "memory_id": "f764740859c49456e39e445c", "memory_type": "foundation", "parent_ids": [], "source": {"reference_id": "f764740859c49456e39e445c", "source_type": "phase2_umr"}, "superseded_by": null}
{"conflicts_with": null, "content": {"text": "Nate: I love action and sci-fi movies, the effects are so cool! What about you, what's your favorite genre?"}, "creation_event": "v3-ingest-3.3-V3-HYBRID-FULL-R6-MIXEDN-CRETRY-locomo-conv-42/session_1-6196a6491c41e1aacb53e648", "creation_timestamp": "2026-09-15T14:20:52.324165+00:00", "equivalent_to": null, "lifecycle_state": "CREATED", "memory_id": "6196a6491c41e1aacb53e648", "memory_type": "foundation", "parent_ids": [], "source": {"reference_id": "6196a6491c41e1aacb53e648", "source_type": "phase2_umr"}, "superseded_by": null}
