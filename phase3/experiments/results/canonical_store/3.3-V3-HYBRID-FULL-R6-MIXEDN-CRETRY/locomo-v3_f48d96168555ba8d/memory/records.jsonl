{"conflicts_with": null, "content": {"text": "Nate: Hey Joanna! Long time no see! What's up? Anything fun going on?"}, "creation_event": "v3-ingest-3.3-V3-HYBRID-FULL-R6-MIXEDN-CRETRY-locomo-conv-42/session_1-b0310beb627f82fab5fd0de5", "creation_timestamp": "2026-09-15T14:20:52.102668+00:00", "equivalent_to": null, "lifecycle_state": "CREATED", "memory_id": "b0310beb627f82fab5fd0de5", "memory_type": "foundation", "parent_ids": [], "source": {"reference_id": "b0310beb627f82fab5fd0de5", "source_type": "phase2_umr"}, "superseded_by": null}
