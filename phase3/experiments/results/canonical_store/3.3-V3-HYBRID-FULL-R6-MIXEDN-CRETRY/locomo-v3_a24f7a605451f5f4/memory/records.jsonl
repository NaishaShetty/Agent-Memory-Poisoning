{"conflicts_with": null, "content": {"text": "Jon: Agreed!"}, "creation_event": "v3-ingest-3.3-V3-HYBRID-FULL-R6-MIXEDN-CRETRY-locomo-conv-30/session_15-6b32b02eb5743d73698e95dd", "creation_timestamp": "2026-09-15T14:09:39.058697+00:00", "equivalent_to": null, "lifecycle_state": "CREATED", "memory_id": "6b32b02eb5743d73698e95dd", "memory_type": "foundation", "parent_ids": [], "source": {"reference_id": "6b32b02eb5743d73698e95dd", "source_type": "phase2_umr"}, "superseded_by": null}
