{"conflicts_with": null, "content": {"text": "Evan: Yeah, it's this peaceful place close to my home. I often go there to relax and unwind."}, "creation_event": "v5-ingest-v5-c-corrected-AMEM_V5-base-CORRECTED-locomo-conv-49/session_16-d2c2aa83956f1483ba39fb30", "creation_timestamp": "2026-09-09T12:25:12.020609+00:00", "equivalent_to": null, "lifecycle_state": "CREATED", "memory_id": "d2c2aa83956f1483ba39fb30", "memory_type": "foundation", "parent_ids": [], "source": {"reference_id": "d2c2aa83956f1483ba39fb30", "source_type": "phase2_umr"}, "superseded_by": null}
