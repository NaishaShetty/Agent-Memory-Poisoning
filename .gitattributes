# Fixed (external review round 3, follow-up, 2026-09-28): these frozen-fingerprint/manifest
# JSON and Python files were being checked out with CRLF on Windows (core.autocrlf=true)
# but LF is what git actually has committed -- the "frozen" fingerprints in this project
# were generated against the CRLF-converted Windows working tree, not the true committed
# bytes, so they would fail on ANY fresh Linux/Mac clone, not just CI. Forcing LF makes the
# working tree match the committed blob on every platform.
phase3/evaluation/fixtures/** text eol=lf
phase3/datasets/candidates/membench/raw/repo_bundle/** text eol=lf
phase3/datasets/candidates/perltqa/raw/** text eol=lf

# Same fix as above, scoped to text extensions only (this bundle also contains binary
# files -- png/mp3/sqlite/ico -- that must NOT go through text/eol conversion).
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.py text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.txt text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.yaml text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.md text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.json text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.sh text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.js text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.ini text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.html text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.css text eol=lf
phase3/datasets/candidates/memoryagentbench/raw/github_repo/**/*.csv text eol=lf
